{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyecare.local/schemas/question.schema.json",
  "title": "Consultation questions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "questions"],
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "operator", "value"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^fact_[a-z0-9_]+$"},
        "operator": {"enum": ["eq", "neq", "in", "not_in", "gt", "gte", "lt", "lte"]},
        "value": {"type": ["string", "integer", "boolean", "array"], "items": {"type": ["string", "integer", "boolean"]}}
      }
    },
    "expression": {
      "oneOf": [
        {"$ref": "#/$defs/predicate"},
        {"type": "object", "additionalProperties": false, "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}}},
        {"type": "object", "additionalProperties": false, "required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}}},
        {"type": "object", "additionalProperties": false, "required": ["not"], "properties": {"not": {"$ref": "#/$defs/expression"}}}
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "content_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fact_id", "prompt", "answer_type", "required", "safety_critical", "citation_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^question_[a-z0-9_]+$"},
          "fact_id": {"type": "string", "pattern": "^fact_[a-z0-9_]+$"},
          "prompt": {"type": "string", "minLength": 5},
          "help_text": {"type": "string", "minLength": 5},
          "answer_type": {"enum": ["yes_no", "integer", "single_choice"]},
          "required": {"type": "boolean"},
          "safety_critical": {"type": "boolean"},
          "show_when": {"$ref": "#/$defs/expression"},
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {"value": {"type": ["string", "integer", "boolean"]}, "label": {"type": "string", "minLength": 1}}
            }
          },
          "citation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^source_[a-z0-9_]+$"}}
        },
        "allOf": [{"if": {"properties": {"answer_type": {"const": "single_choice"}}}, "then": {"required": ["options"]}}]
      }
    }
  }
}
