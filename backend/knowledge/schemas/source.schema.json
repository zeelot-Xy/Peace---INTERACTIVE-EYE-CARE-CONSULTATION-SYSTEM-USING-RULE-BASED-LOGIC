{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyecare.local/schemas/source.schema.json",
  "title": "Eye-care source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "content_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "organization", "url", "published_or_updated", "date_status", "retrieved_on", "supports"],
        "properties": {
          "id": {"type": "string", "pattern": "^source_[a-z0-9_]+$"},
          "title": {"type": "string", "minLength": 3},
          "organization": {"type": "string", "minLength": 2},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "published_or_updated": {"type": ["string", "null"], "format": "date"},
          "date_status": {"enum": ["verified", "not_listed"]},
          "retrieved_on": {"type": "string", "format": "date"},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
        }
      }
    }
  }
}
