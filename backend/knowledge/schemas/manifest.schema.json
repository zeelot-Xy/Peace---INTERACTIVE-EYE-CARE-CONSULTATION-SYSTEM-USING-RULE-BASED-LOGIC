{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyecare.local/schemas/manifest.schema.json",
  "title": "Knowledge package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "package_id", "title", "language", "status", "published_on", "scope", "disclaimer", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "content_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "package_id": {"type": "string", "pattern": "^eye-care-[a-z]{2}-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 5},
    "language": {"const": "en"},
    "status": {"enum": ["draft", "reviewed", "published", "retired"]},
    "published_on": {"type": ["string", "null"], "format": "date"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_age", "maximum_age", "jurisdiction_note", "exclusions"],
      "properties": {
        "minimum_age": {"const": 18},
        "maximum_age": {"type": ["integer", "null"], "minimum": 18},
        "jurisdiction_note": {"type": "string", "minLength": 10},
        "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      }
    },
    "disclaimer": {"type": "string", "minLength": 40},
    "files": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "schema", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z-]+\\.json$"},
          "schema": {"type": "string", "pattern": "^[a-z-]+\\.schema\\.json$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
