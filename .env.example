APP_ENV=development
FLASK_DEBUG=false
# Required outside development; use a cryptographically random value of 32+ characters.
SECRET_KEY=
# Optional; when omitted, JWT signing uses SECRET_KEY.
JWT_SECRET_KEY=
DATABASE_URL=sqlite:///eye_care.db
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1
JWT_COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_MIN_LENGTH=12
# Runtime knowledge package configuration (paths may be absolute or backend-relative).
KNOWLEDGE_PACKAGES_DIR=knowledge/packages
KNOWLEDGE_SCHEMAS_DIR=knowledge/schemas
KNOWLEDGE_ACTIVE_PACKAGE=eye-care-en-1.0.0
KNOWLEDGE_RELOAD_ON_CHANGE=false
# Persisted active-version pointer written only after an administrator publishes a valid package.
KNOWLEDGE_STATE_FILE=
# Maximum compressed and extracted knowledge-package size (5 MiB by default).
KNOWLEDGE_UPLOAD_MAX_BYTES=5242880
# Maximum total HTTP request size, including multipart overhead (6 MiB).
REQUEST_MAX_BYTES=6291456
KNOWLEDGE_ARCHIVE_MAX_ENTRIES=16
KNOWLEDGE_ARCHIVE_MAX_COMPRESSION_RATIO=100
# Application-local limits are appropriate for the packaged single-process release.
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=300 per minute
RATELIMIT_LOGIN=5 per minute
RATELIMIT_REGISTER=5 per 5 minutes
RATELIMIT_REFRESH=20 per minute
RATELIMIT_KNOWLEDGE_UPLOAD=10 per 10 minutes
SECURITY_HSTS_SECONDS=31536000
RETENTION_ABANDONED_DAYS=90
RETENTION_COMPLETED_DAYS=365
RETENTION_TOKEN_DAYS=30
