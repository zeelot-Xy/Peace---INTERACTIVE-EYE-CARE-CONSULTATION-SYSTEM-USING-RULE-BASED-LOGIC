{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyecare.local/schemas/risk-level.schema.json",
  "title": "Risk levels",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "risk_levels"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "content_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "risk_levels": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "rank", "action_window", "citation_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^risk_[a-z0-9_]+$"},
          "label": {"type": "string", "minLength": 3},
          "rank": {"type": "integer", "minimum": 1, "maximum": 4},
          "action_window": {"type": "string", "minLength": 8},
          "citation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^source_[a-z0-9_]+$"}}
        }
      }
    }
  }
}
