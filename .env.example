APP_ENV=development
FLASK_DEBUG=false
# Required outside development; use a cryptographically random value of 32+ characters.
SECRET_KEY=
# Optional; when omitted, JWT signing uses SECRET_KEY.
JWT_SECRET_KEY=
DATABASE_URL=sqlite:///eye_care.db
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1
JWT_COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_MIN_LENGTH=12
# Runtime knowledge package configuration (paths may be absolute or backend-relative).
KNOWLEDGE_PACKAGES_DIR=knowledge/packages
KNOWLEDGE_SCHEMAS_DIR=knowledge/schemas
KNOWLEDGE_ACTIVE_PACKAGE=eye-care-en-1.0.0
KNOWLEDGE_RELOAD_ON_CHANGE=false
# Persisted active-version pointer written only after an administrator publishes a valid package.
KNOWLEDGE_STATE_FILE=
# Maximum compressed and extracted knowledge-package size (5 MiB by default).
KNOWLEDGE_UPLOAD_MAX_BYTES=5242880
